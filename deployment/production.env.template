# =================================================================
# CLIPPING PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env.production and fill in your values
# NEVER commit the actual .env.production file to version control

# =================================================================
# DOMAIN CONFIGURATION
# =================================================================
DOMAIN=your-domain.com
ADMIN_DOMAIN=admin.your-domain.com

# =================================================================
# API CONFIGURATION
# =================================================================
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws

# =================================================================
# CORS CONFIGURATION
# =================================================================
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# Generate strong random secrets (use: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-generate-with-openssl-rand
REDIS_PASSWORD=your-redis-password-here-generate-with-openssl-rand

# Admin interface credentials
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=your-admin-password-here

# =================================================================
# DATABASE CONFIGURATION (If using external databases)
# =================================================================
# PostgreSQL (for user data, metadata)
DATABASE_URL=postgresql://username:password@host:5432/clipping_db

# Supabase (if using)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================================================
# STORAGE CONFIGURATION
# =================================================================
# Options: local, aws, gcs
STORAGE_TYPE=local

# AWS S3 Configuration (if using AWS)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Google Cloud Storage (if using GCS)
GCS_PROJECT_ID=your-gcs-project-id
GCS_KEY_FILE=/path/to/service-account-key.json
GCS_BUCKET=your-gcs-bucket-name

# =================================================================
# CLOUDFLARE CONFIGURATION
# =================================================================
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# =================================================================
# EMAIL CONFIGURATION (for notifications)
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@your-domain.com

# =================================================================
# MONITORING & ANALYTICS
# =================================================================
# Optional: Add monitoring services
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX-X

# =================================================================
# RATE LIMITING CONFIGURATION
# =================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# =================================================================
# WORKER CONFIGURATION
# =================================================================
# AI Worker
AI_WORKER_CONCURRENCY=2
OLLAMA_MODEL=llama3.2:3b

# Video Worker
VIDEO_WORKER_CONCURRENCY=2

# Transcription Worker
TRANSCRIPTION_WORKER_CONCURRENCY=1
WHISPER_MODEL=medium

# Whisper Timestamp Worker
WHISPER_TIMESTAMP_WORKER_CONCURRENCY=1

# =================================================================
# LOGGING CONFIGURATION
# =================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =================================================================
# PERFORMANCE CONFIGURATION
# =================================================================
# Memory limits (in MB)
NODE_OPTIONS=--max-old-space-size=2048

# Video processing limits
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_DURATION_SECONDS=7200

# Upload limits
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_TIMEOUT_MS=300000

# =================================================================
# BACKUP CONFIGURATION
# =================================================================
# Backup settings for persistent data
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# =================================================================
# SSL/TLS CONFIGURATION
# =================================================================
# SSL certificate paths (managed by deployment script)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_CHAIN_PATH=/etc/nginx/ssl/chain.pem

# Let's Encrypt email for certificate renewal
LETSENCRYPT_EMAIL=admin@your-domain.com

# =================================================================
# DEVELOPMENT/DEBUG (set to false in production)
# =================================================================
DEBUG=false
NODE_ENV=production 