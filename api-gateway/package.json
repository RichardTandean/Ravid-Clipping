{
  "name": "video-clipping-api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for Video Clipping Platform - Routes requests to microservices",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "lint": "eslint src/",
    "docker:build": "docker build -t clipping-api-gateway .",
    "docker:run": "docker run -p 3000:3000 clipping-api-gateway"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "video-processing",
    "proxy",
    "routing"
  ],
  "author": "Video Clipping Platform Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.8.1",
    "express-slow-down": "^1.6.0",
    "http-proxy-middleware": "^2.0.6",
    "axios": "^1.4.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "joi": "^17.9.2",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "redis": "^4.6.7",
    "node-cron": "^3.0.2",
    "lodash": "^4.17.21",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
